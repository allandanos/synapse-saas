SYNAPSE_ENV=development
SYNAPSE_SECRET_KEY=dev-only-secret-key-change-me-32-bytes-minimum!
SYNAPSE_DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse
SYNAPSE_REDIS_URL=redis://localhost:6380/0
SYNAPSE_PLANS_FILE=config/plans.yaml
# White-label kit (name, logo, colours, links, email + invoice identity).
# docker compose mounts ./branding at /branding and overrides this path.
SYNAPSE_BRANDING_FILE=branding/branding.yaml
SYNAPSE_BILLING_PROVIDER=manual
# Where browsers reach the console (CORS, cookies, email links) …
SYNAPSE_WEB_ORIGIN=http://localhost:3000
# … and the API (read by the console container at runtime).
SYNAPSE_API_URL=http://localhost:8000
