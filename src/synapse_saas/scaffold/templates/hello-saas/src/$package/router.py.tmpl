"""Projects CRUD: permission-checked, plan-limited, metered, audited — and
every line of it is about projects. The framework does the rest."""

from __future__ import annotations

import uuid

from fastapi import APIRouter, Response, status
from pydantic import BaseModel, ConfigDict, Field
from synapse_saas.authorization.dependencies import require_permission
from synapse_saas.core.pagination import PageDep, paginate
from synapse_saas.core.repository import TenantRepository
from synapse_saas.identity.dependencies import CurrentUser, SessionDep
from synapse_saas.tenancy.dependencies import TenantDep
from synapse_saas.usage.service import UsageService

from $package.models import Project


class ProjectRepository(TenantRepository[Project]):
    model = Project


class ProjectCreate(BaseModel):
    title: str = Field(min_length=1, max_length=200)


class ProjectRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: uuid.UUID
    title: str
    organization_id: uuid.UUID


router = APIRouter(prefix="/projects", tags=["projects"])


@router.get("", response_model=list[ProjectRead])
async def list_projects(
    tenant: TenantDep, session: SessionDep, user: CurrentUser, page: PageDep, response: Response
) -> list[ProjectRead]:
    await require_permission("project:read", user, session, tenant)
    from sqlalchemy import select

    stmt = (
        select(Project)
        .where(Project.organization_id == tenant.organization_id)
        .order_by(Project.created_at.desc())
    )
    rows = await paginate(session, stmt, page, response)
    return [ProjectRead.model_validate(p) for p in rows]


@router.post("", response_model=ProjectRead, status_code=status.HTTP_201_CREATED)
async def create_project(
    body: ProjectCreate, tenant: TenantDep, session: SessionDep, user: CurrentUser
) -> ProjectRead:
    await require_permission("project:manage", user, session, tenant)
    # `projects` is a gauge in the plan catalog: +1 is capacity-checked (402
    # with upgrade hints past the plan's cap) and commits with the row.
    await UsageService(session).adjust_gauge(tenant.organization_id, "projects", 1)
    project = await ProjectRepository(session).add(Project(title=body.title))
    await session.flush()
    return ProjectRead.model_validate(project)


@router.delete("/{project_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_project(
    project_id: uuid.UUID, tenant: TenantDep, session: SessionDep, user: CurrentUser
) -> None:
    await require_permission("project:manage", user, session, tenant)
    repo = ProjectRepository(session)
    project = await repo.get_or_404(project_id)  # cross-tenant ⇒ 404
    await repo.delete(project)
    await UsageService(session).adjust_gauge(tenant.organization_id, "projects", -1)
