FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-install-project --no-dev || uv sync --no-install-project --no-dev
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --no-dev

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$$PATH" PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 1001 app && mkdir -p /data/storage && chown -R 1001:1001 /data/storage
ENV SYNAPSE_STORAGE_ROOT=/data/storage
USER app
EXPOSE 8000
CMD ["uvicorn", "$package.app:app", "--host", "0.0.0.0", "--port", "8000"]
