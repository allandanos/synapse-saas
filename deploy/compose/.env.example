# ── Synapse SaaS · published-images kit ───────────────────────────────────────
# cp .env.example .env, then fill in SYNAPSE_SECRET_KEY. This file is read twice:
# by Compose (image, ports, SYNAPSE_API_URL for the console) and by the api,
# worker and migrate containers (every SYNAPSE_* setting — see the repository's
# root .env.example for the full list). Leave unused keys empty or delete them.

# ── Images ────────────────────────────────────────────────────────────────────
# Registry namespace + tag of synapse-saas-{api,worker,web}. Point at your own
# registry (e.g. ghcr.io/acme) if you mirror or rebuild the images.
SYNAPSE_IMAGE_PREFIX=allandanos
SYNAPSE_VERSION=0.2.0

# ── Host ports ────────────────────────────────────────────────────────────────
SYNAPSE_API_PORT=8000
SYNAPSE_WEB_PORT=3000

# ── Core ──────────────────────────────────────────────────────────────────────
SYNAPSE_ENV=production
# REQUIRED. JWT signing + webhook-secret encryption; at least 32 characters.
# The API refuses to start in production without one. Generate it with:
#   openssl rand -base64 32
SYNAPSE_SECRET_KEY=
# Password of the bundled Postgres (set before the first `up`; the volume keeps it).
# URL-safe characters only (letters, digits, - _ . ~): it is interpolated into the
# database URL unescaped. `openssl rand -hex 24` is a safe generator.
POSTGRES_PASSWORD=synapse

# ── Console ↔ API origins ─────────────────────────────────────────────────────
# Where browsers reach the console (CORS, cookies, links in emails).
SYNAPSE_WEB_ORIGIN=http://localhost:3000
# Where browsers reach the API (console API calls, SSO, logo/favicon). Keep it
# in step with SYNAPSE_API_PORT or your reverse proxy's public URL.
SYNAPSE_API_URL=http://localhost:8000
# The refresh cookie is Secure in production. Browsers accept Secure cookies on
# http://localhost; serving plain HTTP on any other host needs this set to false
# (do that for trials only — put TLS in front for real traffic).
# SYNAPSE_COOKIE_SECURE=false

# ── Billing ───────────────────────────────────────────────────────────────────
# manual | stripe | xendit | paymongo | paddle   (manual = zero external accounts)
SYNAPSE_BILLING_PROVIDER=manual
SYNAPSE_BILLING_CURRENCY=PHP
# Shared token protecting the manual provider's webhook ingest endpoint.
SYNAPSE_MANUAL_WEBHOOK_TOKEN=
# Printed on generated invoices (bank transfer details, pay-by links).
SYNAPSE_MANUAL_PAY_TO_INSTRUCTIONS=
SYNAPSE_STRIPE_SECRET_KEY=
SYNAPSE_STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# No host ⇒ emails are logged, not sent. The sender display name comes from
# branding/branding.yaml (email.from_name, else the product name).
SYNAPSE_SMTP_HOST=
SYNAPSE_SMTP_PORT=587
# none | starttls | ssl
SYNAPSE_SMTP_TLS=starttls
SYNAPSE_SMTP_USERNAME=
SYNAPSE_SMTP_PASSWORD=
SYNAPSE_SMTP_FROM=no-reply@example.com
