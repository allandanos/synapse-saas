# ── Core ──────────────────────────────────────────────────────────────────────
# Settings load from this file only for local development; images never
# contain it (.dockerignore). Point elsewhere or disable with SYNAPSE_ENV_FILE=.
# SYNAPSE_ENV_FILE=.env
SYNAPSE_ENV=development
SYNAPSE_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
SYNAPSE_DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse
# Owner-role DSN for the worker, CLI, and migrations (bypasses RLS). Empty ⇒
# same as SYNAPSE_DATABASE_URL. Required when RLS is on (see below).
SYNAPSE_WORKER_DATABASE_URL=
SYNAPSE_REDIS_URL=redis://localhost:6380/0
# app | app_and_rls  (RLS = Postgres row-level security as defense-in-depth)
# app_and_rls requires the API to connect as a NOBYPASSRLS, non-owner role:
#   synapse-cli db provision-app-role --role synapse_app   (run as the owner)
# then point SYNAPSE_DATABASE_URL at that role and SYNAPSE_WORKER_DATABASE_URL
# at the owner. The API refuses to start if the role and this flag disagree.
SYNAPSE_TENANT_ISOLATION=app

# ── Plans / catalog ───────────────────────────────────────────────────────────
SYNAPSE_PLANS_FILE=config/plans.yaml
# Auto-sync plan catalog to DB on startup (default true; disable in prod where
# migrations/CLI own the sync)
SYNAPSE_AUTO_SYNC_PLANS=true

# ── Identity ──────────────────────────────────────────────────────────────────
# local | keycloak
SYNAPSE_IDENTITY_PROVIDER=local
SYNAPSE_ACCESS_TOKEN_TTL_MINUTES=15
SYNAPSE_REFRESH_TOKEN_TTL_DAYS=30
# Reuse of a rotated refresh token within this window is treated as a benign
# concurrent-refresh race rather than token theft (audited either way).
SYNAPSE_REFRESH_REUSE_GRACE_SECONDS=10

# ── Auth rate limiting (login/register/forgot/reset) ─────────────────────────
# Two buckets per request: client IP and target identity. Either tripping → 429.
# PRODUCTION CEILINGS: the app refuses to start with SYNAPSE_ENV=production if
# per-IP > 100 or per-identity > 20 (dev/e2e suites raise these to register
# many users from one address; that must never reach a deployment).
SYNAPSE_AUTH_RATE_LIMIT_PER_IP=20
SYNAPSE_AUTH_RATE_LIMIT_PER_IDENTITY=5
SYNAPSE_AUTH_RATE_WINDOW_SECONDS=60

# Keycloak (only when SYNAPSE_IDENTITY_PROVIDER=keycloak)
SYNAPSE_KEYCLOAK_BASE_URL=
SYNAPSE_KEYCLOAK_REALM=
SYNAPSE_KEYCLOAK_CLIENT_ID=
SYNAPSE_KEYCLOAK_CLIENT_SECRET=
# Browser SSO uses the authorization-code flow (PKCE); ROPC proxying is opt-in
SYNAPSE_KEYCLOAK_ALLOW_PASSWORD_GRANT=false
# The API callback as Keycloak must see it (only needed behind rewriting proxies)
SYNAPSE_OIDC_REDIRECT_URI=

# ── Billing ───────────────────────────────────────────────────────────────────
# manual | stripe | xendit | paymongo   (manual = zero external accounts)
SYNAPSE_BILLING_PROVIDER=manual
SYNAPSE_BILLING_CURRENCY=PHP
# Shared token protecting the manual provider's webhook ingest endpoint.
SYNAPSE_MANUAL_WEBHOOK_TOKEN=
# Printed on generated invoices (bank transfer details, pay-by links)
SYNAPSE_MANUAL_PAY_TO_INSTRUCTIONS=

# Stripe
SYNAPSE_STRIPE_SECRET_KEY=
SYNAPSE_STRIPE_WEBHOOK_SECRET=

# Xendit
SYNAPSE_XENDIT_SECRET_KEY=
SYNAPSE_XENDIT_WEBHOOK_TOKEN=

# PayMongo
SYNAPSE_PAYMONGO_SECRET_KEY=
SYNAPSE_PAYMONGO_WEBHOOK_SECRET=

# Paddle
SYNAPSE_PADDLE_SECRET_KEY=
SYNAPSE_PADDLE_WEBHOOK_SECRET=

# ── Entitlements / usage ──────────────────────────────────────────────────────
# Grant plan features while past_due (grace period before hard downgrade)
SYNAPSE_GRACE_ON_PAST_DUE=true
# Default fallback plan key for orgs with no (occupying) subscription
SYNAPSE_DEFAULT_PLAN_KEY=free

# ── Console (apps/web) ────────────────────────────────────────────────────────
SYNAPSE_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email (dev default: console log; mailhog when compose profile extras on) ──
# For local mail capture: docker compose --profile extras up -d mailhog, then
# SYNAPSE_SMTP_HOST=mailhog (compose services resolve it by name). Inbox: :8025
SYNAPSE_SMTP_HOST=
SYNAPSE_SMTP_PORT=1025
SYNAPSE_SMTP_FROM=synapse@localhost

# ── Observability ──────────────────────────────────────────────────────────────
# Prometheus /metrics endpoint on the API
SYNAPSE_METRICS_ENABLED=true
# OpenTelemetry: empty = tracing compiled in but inert. Set to enable OTLP gRPC export.
SYNAPSE_OTEL_EXPORTER_ENDPOINT=
SYNAPSE_OTEL_SERVICE_NAME=synapse-saas

# ── Retention (worker purge job) ──────────────────────────────────────────────
SYNAPSE_AUDIT_RETENTION_DAYS=365

# ── Storage (S3-compatible; unset = local disk) ──────────────────────────────
# MinIO (compose profile extras): endpoint http://localhost:9000, bucket synapse
SYNAPSE_S3_ENDPOINT_URL=
SYNAPSE_S3_REGION=us-east-1
SYNAPSE_S3_BUCKET=
SYNAPSE_S3_ACCESS_KEY_ID=
SYNAPSE_S3_SECRET_ACCESS_KEY=
# Local-disk fallback location when no bucket is configured
SYNAPSE_STORAGE_ROOT=.storage
SYNAPSE_STORAGE_PRESIGN_SECONDS=3600

# Fine-grained authorization (ADR 0009). rbac (default) | openfga
SYNAPSE_AUTHZ_BACKEND=rbac
SYNAPSE_OPENFGA_URL=
SYNAPSE_OPENFGA_STORE_ID=
SYNAPSE_OPENFGA_MODEL_ID=
SYNAPSE_OPENFGA_API_TOKEN=
SYNAPSE_OPENFGA_FAIL_MODE=closed
